# Bootstrap do primeiro admin. Usado apenas se não existir admin no banco.
ADMIN_BOOTSTRAP_NAME=Administrador Fluxo
ADMIN_BOOTSTRAP_EMAIL=admin@fluxostore.local
ADMIN_BOOTSTRAP_PASSWORD=troque-essa-senha-forte

# Discord OAuth2
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
DISCORD_REDIRECT_URI=http://localhost:3333/api/auth/discord/callback
DISCORD_SCOPES=identify email

# Discord Bot + Webhook
DISCORD_BOT_TOKEN=seu_token_do_bot
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_GUILD_ID=id_do_servidor_opcional

# SMTP para email de confirmação e decisão
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM="Fluxo Store <recrutamento@fluxostore.com>"

# Frontend Vite
VITE_API_URL=http://localhost:3333
VITE_APP_NAME=Fluxo Store Recruitment

# Bot worker
BOT_PORT=3334
BOT_API_SECRET=token-interno-forte-para-health-ou-futuras-integracoes

# API
NODE_ENV=production
API_PORT=3333
API_URL=http://localhost:3333
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://contatojrconecicao_db_user:6g0q7xJs4MOR0ABO@cluster0.ysvqu1c.mongodb.net/?appName=Cluster0
JWT_SECRET=c6588645e243a540b84ec7b33370dbb82aa85176d2ea3fa1c2f929d24ba9647c8d639e8697b4d2f3b646e0044d0e1a64dcad82b34be971fad0937a5863c1ee39
JWT_EXPIRES_IN=8h
